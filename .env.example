# Local synthetic demo only. Replace this placeholder before starting Compose.
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_DEMO_PASSWORD
OPSLENS_HOST_PORT=5006
OPSLENS_ALLOWED_WS_ORIGINS=localhost:5006,127.0.0.1:5006
OPSLENS_BUILD_REVISION=UNKNOWN
# Native Python reads process environment variables; it does not load this file.
# Use a separate database ending in _test for integration tests.
# OPSLENS_RUNTIME_DATABASE_URL=postgresql+psycopg://EXAMPLE_USER:EXAMPLE_PASSWORD@127.0.0.1:55432/opslens_runtime
# OPSLENS_ANALYSIS_DB=data/demo/generated/opslens_demo.duckdb
# OPSLENS_DEMO_MODE=true
# OPSLENS_UI_HOST=127.0.0.1
# OPSLENS_UI_PORT=5006
# Optional native Ollama: the tag must exist in the local `ollama list` output.
# Compose does not forward these model settings to the application container.
# OPSLENS_LLM_PROVIDER=ollama
# OPSLENS_OLLAMA_MODEL=REPLACE_WITH_INSTALLED_MODEL_TAG
# OPSLENS_OLLAMA_BASE_URL=http://127.0.0.1:11434
# OPSLENS_LLM_NUM_CTX=4096
# OPSLENS_LLM_NUM_PREDICT=1024
# OPSLENS_LLM_TIMEOUT_SECONDS=180
# OPSLENS_LLM_MAX_REPAIRS=1
