{
  "metric_id": "approved_refund_amount",
  "name": "已批准退款金额",
  "aliases": [
    "Approved Refund Amount"
  ],
  "description": "成交订单 cohort 的 approved 退款金额，按原订单 paid_at 归属；非退款发生月。",
  "version": "1.0",
  "status": "ACTIVE",
  "metric_type": "BASE",
  "unit": "CNY",
  "expression": "SUM(refunds.refund_amount)",
  "dependencies": [],
  "source_tables": [
    "orders",
    "refunds"
  ],
  "source_columns": [
    "orders.order_id",
    "orders.order_status",
    "orders.paid_at",
    "refunds.order_id",
    "refunds.refund_status",
    "refunds.refund_amount"
  ],
  "time_semantics": {
    "time_column": "orders.paid_at",
    "timezone": "Asia/Shanghai",
    "default_grain": "month",
    "allowed_grains": [
      "day",
      "week",
      "month"
    ]
  },
  "filters": [
    {
      "column": "orders.order_status",
      "operator": "IN",
      "value": [
        "paid",
        "completed"
      ]
    },
    {
      "column": "refunds.refund_status",
      "operator": "EQ",
      "value": "approved"
    }
  ],
  "allowed_dimensions": [
    "orders.region",
    "channels.channel_name",
    "channels.channel_type"
  ],
  "refund_policy": "AFTER_APPROVED_REFUND",
  "owner": "OpsLens 合成业务团队"
}
