{
  "metric_id": "net_gmv",
  "name": "净GMV",
  "aliases": [
    "净 GMV",
    "Net GMV",
    "GMV"
  ],
  "description": "同一成交订单 cohort 毛 GMV 减已批准退款金额；退款过滤仅作用于退款分量，保留未退款订单。",
  "version": "1.0",
  "status": "ACTIVE",
  "metric_type": "DERIVED",
  "unit": "CNY",
  "expression": "gross_gmv - approved_refund_amount",
  "dependencies": [
    "gross_gmv",
    "approved_refund_amount"
  ],
  "source_tables": [
    "order_items",
    "orders",
    "refunds"
  ],
  "source_columns": [
    "orders.order_id",
    "orders.order_status",
    "orders.paid_at",
    "order_items.order_id",
    "order_items.quantity",
    "order_items.unit_price",
    "order_items.discount_amount",
    "refunds.order_id",
    "refunds.refund_status",
    "refunds.refund_amount"
  ],
  "time_semantics": {
    "time_column": "orders.paid_at",
    "timezone": "Asia/Shanghai",
    "default_grain": "month",
    "allowed_grains": [
      "day",
      "week",
      "month"
    ]
  },
  "filters": [
    {
      "column": "orders.order_status",
      "operator": "IN",
      "value": [
        "paid",
        "completed"
      ]
    }
  ],
  "allowed_dimensions": [
    "orders.region",
    "channels.channel_name",
    "channels.channel_type"
  ],
  "refund_policy": "AFTER_APPROVED_REFUND",
  "owner": "OpsLens 合成业务团队"
}
